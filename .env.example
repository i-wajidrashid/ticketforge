# ---------------------------------------------------------------------------
# TicketForge local configuration. Copy to .env; never commit .env.
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-change-me-0123456789abcdefghijklmnop
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# MySQL: two logical databases owned by two services (core + checkout)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=core
CHECKOUT_DATABASE=checkout
MYSQL_USER=ticketforge
MYSQL_PASSWORD=ticketforge
MYSQL_ROOT_PASSWORD=root

# Redis: Celery broker, cache, rate limits and the Channels layer
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Meilisearch
MEILI_URL=http://search:7700
MEILI_MASTER_KEY=dev-meili-master-key
MEILI_INDEX=events

# Shared secrets for cross-service JWT and signed QR tokens
JWT_SECRET=dev-jwt-secret-change-me-please-32bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
QR_SECRET=dev-qr-secret-change-me-please-32bytes

# Stripe runs in TEST MODE only.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Mailpit locally (http://localhost:8025)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=tickets@ticketforge.local

# Public origin used in emails and CORS allow-list
SITE_ORIGIN=https://localhost
